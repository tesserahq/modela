{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus instance scraping danihodovic/celery-exporter, which listens to the Celery event bus on the shared Redis broker",
      "type": "datasource",
      "pluginId": "prometheus"
    },
    {
      "name": "DS_TEMPO",
      "label": "Tempo",
      "description": "Tempo instance receiving OTLP traces from OTel-instrumented workers (currently modela's Celery worker and NATS worker)",
      "type": "datasource",
      "pluginId": "tempo"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "datasource", "id": "tempo", "name": "Tempo", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "1.0.0" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "1.0.0" },
    { "type": "panel", "id": "table", "name": "Table", "version": "1.0.0" },
    { "type": "panel", "id": "traces", "name": "Traces", "version": "1.0.0" }
  ],
  "title": "Celery Worker Telemetry",
  "description": "Task throughput, latency, and error rate for any Celery worker in this infra, sourced from celery-exporter (Celery event bus → Prometheus) — the shared org-wide pattern. Pick the queue to inspect via the Queue variable. Includes drill-down into raw traces in Tempo for workers with OTel CeleryInstrumentor wired up.",
  "uid": "celery-worker-telemetry",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "timezone": "browser",
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "tags": ["celery", "worker", "celery-exporter"],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "label": "Prometheus"
      },
      {
        "name": "DS_TEMPO",
        "type": "datasource",
        "query": "tempo",
        "current": {},
        "hide": 0,
        "label": "Tempo"
      },
      {
        "name": "queue_name",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(celery_queue_length, queue_name)",
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "current": { "text": "modela", "value": "modela" },
        "label": "Queue",
        "description": "Every worker in this infra routes tasks to a dedicated queue named after the app (modela, conversa, indexa, eventa, orcha, quore, ...). Pick one to scope all panels below to that worker."
      },
      {
        "name": "worker_hostname",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(celery_task_received_total{queue_name=\"$queue_name\"}, hostname)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" },
        "label": "Worker hostname",
        "description": "celery_worker_up / celery_worker_tasks_active aren't labeled with queue_name, so this variable derives the selected queue's worker hostnames from a queue-scoped metric to filter them."
      },
      {
        "name": "tempo_service_name",
        "type": "textbox",
        "current": { "text": "modela-worker.*", "value": "modela-worker.*" },
        "label": "Tempo service name (regex)",
        "description": "Matches OTEL_SERVICE_NAME for the worker process(es) in Tempo. Only modela's worker has OTel tracing wired up today — update this (or leave the trace panels empty) when switching Queue to a different app."
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Overview",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Task throughput",
      "description": "Rate of tasks received by the selected queue's worker(s).",
      "gridPos": { "h": 6, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(rate(celery_task_received_total{queue_name=\"$queue_name\"}[$__rate_interval]))",
          "legendFormat": "tasks/sec",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Success rate",
      "gridPos": { "h": 6, "w": 4, "x": 4, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "100 * sum(rate(celery_task_succeeded_total{queue_name=\"$queue_name\"}[$__rate_interval])) / sum(rate(celery_task_received_total{queue_name=\"$queue_name\"}[$__rate_interval]))",
          "legendFormat": "success %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 95 },
              { "color": "green", "value": 99 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area" }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Failure rate",
      "gridPos": { "h": 6, "w": 4, "x": 8, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "100 * sum(rate(celery_task_failed_total{queue_name=\"$queue_name\"}[$__rate_interval])) / sum(rate(celery_task_received_total{queue_name=\"$queue_name\"}[$__rate_interval]))",
          "legendFormat": "failure %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area" }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "P95 task runtime",
      "gridPos": { "h": 6, "w": 4, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.95, sum(rate(celery_task_runtime_bucket{queue_name=\"$queue_name\"}[$__rate_interval])) by (le))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 2 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area" }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Queue backlog",
      "description": "Current number of unconsumed messages on the selected queue.",
      "gridPos": { "h": 6, "w": 4, "x": 16, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "celery_queue_length{queue_name=\"$queue_name\"}",
          "legendFormat": "backlog",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 50 },
              { "color": "red", "value": 200 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area" }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Active worker processes",
      "description": "celery_active_process_count reflects concurrency (prefork children), not in-flight task count.",
      "gridPos": { "h": 6, "w": 4, "x": 20, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "celery_active_process_count{queue_name=\"$queue_name\"}",
          "legendFormat": "processes",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area" }
    },
    {
      "id": 8,
      "type": "row",
      "title": "By task",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Task throughput by task name",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(rate(celery_task_received_total{queue_name=\"$queue_name\"}[$__rate_interval])) by (name)",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] } }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "P95 runtime by task name",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.95, sum(rate(celery_task_runtime_bucket{queue_name=\"$queue_name\"}[$__rate_interval])) by (le, name))",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] } }
    },
    {
      "id": 11,
      "type": "table",
      "title": "Failures by task name (selected range)",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(increase(celery_task_failed_total{queue_name=\"$queue_name\"}[$__range])) by (name, exception)",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "renameByName": { "name": "Task", "exception": "Exception", "Value": "Failures" }
          }
        }
      ],
      "fieldConfig": { "defaults": { "custom": { "align": "left" } }, "overrides": [] }
    },
    {
      "id": 12,
      "type": "table",
      "title": "Retries by task name (selected range)",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(increase(celery_task_retried_total{queue_name=\"$queue_name\"}[$__range])) by (name)",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "refId": "A"
        }
      ],
      "transformations": [
        { "id": "organize", "options": { "renameByName": { "name": "Task", "Value": "Retries" } } }
      ],
      "fieldConfig": { "defaults": { "custom": { "align": "left" } }, "overrides": [] }
    },
    {
      "id": 13,
      "type": "row",
      "title": "Workers",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Worker up/down",
      "description": "1 = up, 0 = down, per worker process hostname. Scoped to hostnames seen consuming from the selected queue via $worker_hostname.",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "celery_worker_up{hostname=~\"$worker_hostname\"}",
          "legendFormat": "{{hostname}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "max": 1 }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull"] } }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Active in-flight tasks per worker",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "celery_worker_tasks_active{hostname=~\"$worker_hostname\"}",
          "legendFormat": "{{hostname}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] } }
    },
    {
      "id": 16,
      "type": "row",
      "title": "Trace drill-down (Tempo)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 31 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 17,
      "type": "traces",
      "title": "Recent errored task traces",
      "description": "TraceQL query against Tempo for spans with an error status. Only populated for workers with OTel CeleryInstrumentor wired up (currently modela's worker).",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 32 },
      "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
          "query": "{resource.service.name=~\"$tempo_service_name\" && status=error}",
          "queryType": "traceql",
          "limit": 20,
          "refId": "A"
        }
      ]
    },
    {
      "id": 18,
      "type": "traces",
      "title": "Slow task traces (> 2s)",
      "description": "TraceQL query against Tempo for spans exceeding a 2s duration threshold. Adjust the threshold to taste.",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 32 },
      "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
          "query": "{resource.service.name=~\"$tempo_service_name\" && duration > 2s}",
          "queryType": "traceql",
          "limit": 20,
          "refId": "A"
        }
      ]
    }
  ]
}
